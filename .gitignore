# _book 构建中间产物（print.html 由 build_book.py 生成）
_book/portfolio-book.print.html
_book/_pass1.pdf
_book/_edge_profile_*/

# 🔴 _book 的**成品**一律不进仓库、不上 Pages：
#    `黄家辉_AI数字化落地作品集.pdf` 按 brief §0 明确「禁止公开下载」。
#    2026-10-15 实测它曾被 git 跟踪并可从线上直接下载（HTTP 200 / 1.6MB），
#    且 portfolio-book.html 还带着「5 年+」「8 个 span」等旧口径。
#    脚本（*.py）保留在仓库，成品输出忽略。
_book/*.pdf
_book/portfolio-book.html

# 🔴 临时探针页一律用 *-probe.html / _old-*.html 命名，并在根目录忽略：
#    GitHub Pages + .nojekyll 会把仓库里所有文件发布出去，探针页留在根目录
#    就等于挂到公网上（2026-10-16 差点把 p14-probe.html 提交上去）。
#    探针脚本本体放 .dsh-workspace/artifacts/，生成的临时页用完即删。
*-probe.html
_old-*.html
_old-*.js

# Edge 无头打印 PDF 用的独立 profile（build-resume-pdf.mjs）
.dsh-workspace/artifacts/edge-pdf-profile/

# 视觉验证与工具产物
.dsh-vision-router/
.verify/
